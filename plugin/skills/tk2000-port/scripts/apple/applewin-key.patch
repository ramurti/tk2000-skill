@@ -42,6 +65,40 @@ void MemoryInfoProvider::HandleRequest(const HttpRequest& request, HttpResponse&
     else if (path == "/api/read" || path == "/read") {
         HandleApiRead(request, response);
     }
+    else if (path == "/api/key" || path == "/key") {
+        // tk2000-tools: press a key (ASCII code in hex), e.g. /api/key?code=0D
+        std::string codeStr = request.GetQueryParam("code", "20");
+        if (!codeStr.empty() && codeStr[0] == '$') codeStr = codeStr.substr(1);
+        int code = static_cast<int>(std::stoul(codeStr, nullptr, 16)) & 0x7F;
+        addKeyToBuffer(static_cast<BYTE>(code));
+        JsonBuilder json;
+        json.BeginObject().Add("key", code).EndObject();
+        SendJsonResponse(response, json.ToPrettyString());
+    }
+    else if (path == "/api/joy" || path == "/joy") {
+        // tk2000-tools: /api/joy?x=0..255&y=0..255&b0=0|1&b1=0|1 (each parameter optional)
+        std::string v;
+        if (!(v = request.GetQueryParam("x", "")).empty()) g_joyAxis[0] = std::stoi(v);
+        if (!(v = request.GetQueryParam("y", "")).empty()) g_joyAxis[1] = std::stoi(v);
+        if (!(v = request.GetQueryParam("b0", "")).empty()) g_joyButton[0] = v != "0";
+        if (!(v = request.GetQueryParam("b1", "")).empty()) g_joyButton[1] = v != "0";
+        JsonBuilder json;
+        json.BeginObject().Add("x", g_joyAxis[0].load()).Add("y", g_joyAxis[1].load())
+            .Add("b0", g_joyButton[0].load() ? 1 : 0).Add("b1", g_joyButton[1].load() ? 1 : 0).EndObject();
+        SendJsonResponse(response, json.ToPrettyString());
+    }
+    else if (path == "/api/snapshot" || path == "/snapshot") {
+        // tk2000-tools: /api/snapshot?file=/abs/path.yaml[&at=CYCLE] saves a save-state at (or after) a cycle
+        std::string file = request.GetQueryParam("file", "");
+        unsigned long long at = std::stoull(request.GetQueryParam("at", "0"));
+        {
+            std::lock_guard<std::mutex> lock(g_tk2000SnapMutex);
+            g_tk2000Snaps.emplace_back(at, file);
+        }
+        JsonBuilder json;
+        json.BeginObject().Add("file", file).EndObject();
+        SendJsonResponse(response, json.ToPrettyString());
+    }
     else if (path == "/api/zeropage" || path == "/zeropage") {
         HandleApiZeroPage(request, response);
     }
