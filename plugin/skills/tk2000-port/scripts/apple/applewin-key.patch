+// tk2000-tools: save-states requested over HTTP, written by the main loop between frames
+std::mutex g_tk2000SnapMutex;
+std::vector<std::pair<unsigned long long, std::string>> g_tk2000Snaps;   // (cumulative cycle, file)
+
+// tk2000-tools: a joystick driven over HTTP (/api/joy), used when no game controller is connected
+// (without it, sa2 reads both paddles as 255: the joystick looks pushed to the corner)
+#include "linux/paddle.h"
+namespace {
+    std::atomic<int> g_joyAxis[2] = {128, 128};
+    std::atomic<bool> g_joyButton[2] = {false, false};
+    class ApiPaddle : public Paddle {
+    public:
+        bool getButton(int i) const override { return g_joyButton[i & 1]; }
+        double getAxis(int i) const override { return g_joyAxis[i & 1] / 127.5 - 1.0; }
+    };
+}
+std::shared_ptr<Paddle> tk2000ApiPaddle() { return std::make_shared<ApiPaddle>(); }
 
