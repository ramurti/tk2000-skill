 #include "Core.h"
 #include "NTSC.h"
 #include "Interface.h"
+#include "SaveState.h"
+#include <mutex>
+#include <vector>
+#include <utility>
+
+// tk2000-tools: save-states requested over HTTP (debugserver/MemoryInfoProvider.cpp)
+extern std::mutex g_tk2000SnapMutex;
+extern std::vector<std::pair<unsigned long long, std::string>> g_tk2000Snaps;
+
+static void tk2000SaveRequestedSnapshots()
+{
+    std::lock_guard<std::mutex> lock(g_tk2000SnapMutex);
+    for (auto it = g_tk2000Snaps.begin(); it != g_tk2000Snaps.end();)
+    {
+        if (g_nCumulativeCycles >= it->first)
+        {
+            Snapshot_SetFilename(it->second);
+            Snapshot_SaveState();
+            it = g_tk2000Snaps.erase(it);
+        }
+        else
+            ++it;
+    }
+}
 
